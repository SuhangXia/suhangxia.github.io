---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Suhang Xia" pageClass="inner-page" noindex={true}>
  <section class="not-found section-shell">
    <p class="eyebrow"><span>404</span>Page not found</p>
    <h1>This path reaches an empty workspace.</h1>
    <p>The page may have moved, or the address may be incomplete.</p>
    <a class="text-link" href="/">Return home <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
