---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ResearchThesis from '../components/ResearchThesis.astro';
import ScrollStory from '../components/ScrollStory.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import AboutPreview from '../components/AboutPreview.astro';
import SubmissionUpdate from '../components/SubmissionUpdate.astro';
import { projects } from '../data/projects';

const homeProjectOrder = [
  'tactile-umi',
  'touch-until-certain',
  'robocup-ur5e',
  'percutaneous-puncture-surgical-robot',
  'neurosurgical-robot',
  'uav-navigation',
];
const homeProjects = homeProjectOrder.flatMap((slug) => projects.filter((project) => project.slug === slug));
---

<BaseLayout pageClass="home-page">
  <Hero />
  <ResearchThesis />
  <ScrollStory />

  <section class="featured-heading section-shell" aria-labelledby="featured-title">
    <div class="section-rule" data-reveal-line></div>
    <p class="eyebrow" data-reveal>Selected research</p>
    <h2 id="featured-title" data-reveal>Systems, models, and the questions between them.</h2>
    <SubmissionUpdate />
  </section>

  <div class="featured-projects">
    {homeProjects.map((project) => <ProjectFeature project={project} />)}
  </div>
  <AboutPreview />
</BaseLayout>

<script>
  const homeNavigationKey = 'suhangxia-home-project-navigation';
  if ('scrollRestoration' in window.history) window.history.scrollRestoration = 'auto';

  document.addEventListener('click', (event) => {
    if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
    const anchor = (event.target as Element).closest<HTMLAnchorElement>('a[href]');
    if (!anchor || anchor.origin !== window.location.origin || !anchor.pathname.startsWith('/research/')) return;

    try {
      window.sessionStorage.setItem(homeNavigationKey, anchor.pathname);
    } catch {
      // The project link still works; only native scroll restoration is skipped.
    }
  });
</script>
