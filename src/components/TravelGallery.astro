---
import { Image, getImage } from 'astro:assets';
import { journeys } from '../data/journeys';

const photographs = await Promise.all(journeys.map(async (journey) => ({
  ...journey,
  full: await getImage({ src: journey.media, width: Math.min(journey.media.width, 1800), format: 'webp', quality: 90 }),
})));
const count = String(photographs.length).padStart(2, '0');
---

<section class="travel-gallery" id="travels" aria-labelledby="travel-title" data-travel-gallery>
  <header class="travel-gallery__heading">
    <div data-reveal>
      <p class="eyebrow"><span aria-hidden="true">↗</span> Beyond the lab</p>
      <h3 id="travel-title">Elsewhere<span>.</span></h3>
    </div>
    <div class="travel-gallery__introduction" data-reveal>
      <p>Mountains, coastlines, and a change of perspective.</p>
      <span>{count} photographs <span aria-hidden="true">/</span> A personal travel journal</span>
    </div>
  </header>

  <div class="travel-gallery__grid">
    {photographs.map((photo, index) => (
      <figure
        class:list={['travel-photo', { 'travel-photo--portrait': photo.portrait }]}
        style={`--photo-area: ${photo.id}; --photo-position: ${photo.position};`}
        data-travel-photo
      >
        <a
          class="travel-photo__link"
          href={photo.full.src}
          target="_blank"
          rel="noopener"
          data-travel-open
          data-city={photo.city}
          data-country={photo.country}
          aria-label={`View photograph: ${photo.city}, ${photo.country}`}
          aria-describedby={`travel-caption-${photo.id}`}
        >
          <Image
            src={photo.media}
            alt={photo.alt}
            width={Math.min(photo.media.width, 1280)}
            widths={[400, 640, 960, 1280].filter((width) => width <= photo.media.width)}
            sizes="(max-width: 599px) calc(100vw - 40px), (max-width: 999px) 46vw, (min-width: 1792px) 552px, 31vw"
            format="webp"
            quality={86}
            loading="lazy"
            decoding="async"
          />
          <span class="travel-photo__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span class="travel-photo__expand" aria-hidden="true">↗</span>
        </a>
        <figcaption id={`travel-caption-${photo.id}`}>
          <span class="travel-photo__country">{photo.country}</span>
          <span class="travel-photo__city">{photo.city}</span>
        </figcaption>
      </figure>
    ))}
  </div>

  <div class="travel-gallery__colophon">
    <span>A few places along the way.</span>
    <span>Open a photograph to explore <span aria-hidden="true">↗</span></span>
  </div>

  <dialog class="travel-viewer" aria-labelledby="travel-viewer-title" data-travel-viewer>
    <div class="travel-viewer__top">
      <span class="eyebrow">Elsewhere / Travel journal</span>
      <form method="dialog"><button class="travel-viewer__close" aria-label="Close photograph" autofocus>Close <span aria-hidden="true">×</span></button></form>
    </div>
    <div class="travel-viewer__stage">
      <img alt="" data-travel-full />
    </div>
    <div class="travel-viewer__bottom">
      <div class="travel-viewer__caption" aria-live="polite" aria-atomic="true">
        <p data-travel-country></p>
        <h4 id="travel-viewer-title" data-travel-city></h4>
      </div>
      <div class="travel-viewer__navigation" aria-label="Photograph navigation">
        <button type="button" aria-label="Previous photograph" data-travel-prev>←</button>
        <span class="travel-viewer__counter"><span data-travel-current>01</span> / {count}</span>
        <button type="button" aria-label="Next photograph" data-travel-next>→</button>
      </div>
    </div>
  </dialog>
</section>

<script>
  import '../scripts/travel-gallery';
</script>

<style>
  .travel-gallery {
    --gallery-gap: clamp(0.65rem, 1.25vw, 1.4rem);
    margin-top: clamp(5rem, 8vw, 9rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line-inverse);
    scroll-margin-top: calc(var(--header-height) + 2rem);
  }

  .travel-gallery__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2rem, 4vw, 4rem);
  }

  .travel-gallery__heading .eyebrow { color: #b7b9ac; }
  h3 {
    margin-top: 1.1rem;
    font-family: var(--font-serif);
    font-size: clamp(4.5rem, 8vw, 8.5rem);
    font-weight: 420;
    letter-spacing: -0.055em;
    line-height: 0.9;
  }
  h3 > span { color: var(--accent); }
  .travel-gallery__introduction { max-width: 22rem; padding-bottom: 0.25rem; }
  .travel-gallery__introduction > p { max-width: 20rem; color: #d1d0c6; font-size: 0.95rem; line-height: 1.7; }
  .travel-gallery__introduction > span { display: block; margin-top: 1.25rem; color: #aaada2; font-size: 0.62rem; letter-spacing: 0.07em; line-height: 1.8; text-transform: uppercase; }
  .travel-gallery__introduction > span > span { padding-inline: 0.6rem; color: var(--accent); }

  .travel-gallery__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-areas:
      'venice paris edinburgh'
      'zermatt paris bosphorus'
      'alps milan viewpoint'
      'alps milan versailles';
    gap: var(--gallery-gap);
  }

  .travel-photo {
    position: relative;
    isolation: isolate;
    grid-area: var(--photo-area);
    min-width: 0;
    min-height: 0;
    aspect-ratio: 3 / 2;
    border-radius: 3px;
    background: #2c302c;
  }
  .travel-photo--portrait { aspect-ratio: auto; }
  .travel-photo__link { position: absolute; inset: 0; display: block; overflow: hidden; border-radius: inherit; cursor: zoom-in; }
  .travel-photo__link::before {
    position: absolute;
    z-index: 1;
    inset: 0;
    border: 1px solid rgb(247 245 239 / 12%);
    border-radius: inherit;
    background: linear-gradient(180deg, rgb(9 15 13 / 12%), transparent 28%, transparent 50%, rgb(9 15 13 / 68%));
    content: '';
    pointer-events: none;
  }
  .travel-photo__link::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(115deg, transparent 20%, rgb(255 249 230 / 13%) 45%, transparent 70%);
    opacity: 0;
    transform: translateX(-70%);
    content: '';
    pointer-events: none;
  }
  .travel-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--photo-position);
    filter: saturate(0.88);
    transition: transform 850ms var(--ease-out), filter 600ms ease;
  }
  .travel-photo__number { position: absolute; z-index: 2; top: 1rem; left: 1rem; color: #fff; font-size: 0.63rem; font-variant-numeric: tabular-nums; letter-spacing: 0.1em; text-shadow: 0 1px 6px rgb(0 0 0 / 60%); }
  .travel-photo__expand { position: absolute; z-index: 2; top: 0.75rem; right: 0.75rem; display: grid; width: 2.2rem; height: 2.2rem; place-items: center; border: 1px solid rgb(255 255 255 / 32%); border-radius: 50%; background: rgb(18 23 19 / 30%); color: #fff; font-size: 1.15rem; backdrop-filter: blur(6px); transition: background 250ms ease, transform 350ms var(--ease-out); }
  figcaption { position: absolute; z-index: 2; right: 1.4rem; bottom: 1.25rem; left: 1.4rem; display: grid; gap: 0.4rem; pointer-events: none; }
  .travel-photo__country { color: #eeeae0; font-size: 0.6rem; font-weight: 600; letter-spacing: 0.17em; line-height: 1.4; text-transform: uppercase; text-shadow: 0 1px 5px rgb(0 0 0 / 40%); }
  .travel-photo__city { font-family: var(--font-serif); font-size: clamp(1.7rem, 2.6vw, 3rem); font-weight: 450; letter-spacing: -0.02em; line-height: 1; }
  .travel-photo:focus-within { z-index: 3; }
  .travel-photo__link:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .travel-photo__link:focus-visible .travel-photo__expand { background: var(--accent-dark); }

  .travel-gallery__colophon { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1.5rem; padding-top: 1.15rem; border-top: 1px solid var(--line-inverse); color: #aaada2; font-size: 0.65rem; letter-spacing: 0.035em; line-height: 1.6; }
  .travel-gallery__colophon > span:last-child > span { margin-left: 0.5rem; color: var(--accent); }

  .travel-viewer { --accent: #df775a; width: min(94vw, 100rem); max-width: 94vw; max-height: 94dvh; margin: auto; padding: clamp(1rem, 2.2vw, 2rem); overflow: auto; border: 1px solid rgb(247 245 239 / 20%); border-radius: 4px; background: #171b18; color: var(--white); box-shadow: 0 2rem 8rem rgb(0 0 0 / 40%); overscroll-behavior: contain; }
  .travel-viewer::backdrop { background: rgb(5 9 7 / 88%); backdrop-filter: blur(10px); }
  .travel-viewer[open] { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; height: min(90dvh, 66rem); animation: viewer-enter 250ms var(--ease-out) both; }
  .travel-viewer__top, .travel-viewer__bottom { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .travel-viewer__top { margin-bottom: 1rem; }
  .travel-viewer__top > span { color: #b7b9ac; font-size: 0.6rem; }
  .travel-viewer button { display: inline-flex; min-width: 2.75rem; min-height: 2.75rem; align-items: center; justify-content: center; padding: 0.5rem; border: 1px solid var(--line-inverse); background: transparent; color: inherit; cursor: pointer; transition: background 200ms ease; }
  .travel-viewer button:hover { background: rgb(247 245 239 / 10%); }
  .travel-viewer .travel-viewer__close { gap: 0.8rem; padding-inline: 0.85rem; border-radius: 2rem; font-size: 0.7rem; }
  .travel-viewer__close > span { font-size: 1.2rem; }
  .travel-viewer__stage { display: grid; min-height: 0; place-items: center; background: #121512; }
  .travel-viewer__stage img { width: 100%; height: 100%; min-height: 0; object-fit: contain; }
  .travel-viewer__bottom { margin-top: 1.25rem; }
  .travel-viewer__caption > p { color: #b7b9ac; font-size: 0.6rem; letter-spacing: 0.13em; line-height: 1.5; text-transform: uppercase; }
  .travel-viewer__caption > h4 { margin: 0.3rem 0 0; font-family: var(--font-serif); font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 450; }
  .travel-viewer__navigation { display: flex; align-items: center; gap: 1rem; }
  .travel-viewer__navigation button { border-radius: 50%; font-size: 1.2rem; }
  .travel-viewer__counter { color: #b7b9ac; font-size: 0.68rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .travel-viewer__counter > span { color: var(--white); }

  @keyframes viewer-enter { from { opacity: 0; transform: translateY(0.7rem); } to { opacity: 1; transform: none; } }
  @keyframes photo-sheen { 0% { opacity: 0; transform: translateX(-70%); } 35% { opacity: 1; } 100% { opacity: 0; transform: translateX(70%); } }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .travel-photo__link { transition: box-shadow 450ms ease, translate 450ms var(--ease-out); }
    figcaption { transition: translate 450ms var(--ease-out); }
    .travel-photo:hover { z-index: 3; }
    .travel-photo:hover .travel-photo__link { translate: 0 -4px; box-shadow: 0 1.1rem 2.8rem rgb(0 0 0 / 25%); }
    .travel-photo:hover figcaption { translate: 0 -4px; }
    .travel-photo:hover img { transform: scale(1.035); filter: saturate(1); }
    .travel-photo:hover .travel-photo__link::after { animation: photo-sheen 1.1s ease-out both; }
    .travel-photo:hover .travel-photo__expand { transform: rotate(45deg); background: rgb(18 23 19 / 65%); }
  }

  @media (min-width: 600px) and (max-width: 999px) {
    .travel-gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas: 'venice paris' 'edinburgh paris' 'zermatt bosphorus' 'alps milan' 'alps milan' 'viewpoint versailles';
      grid-auto-rows: calc((100vw - 2 * var(--page-gutter) - var(--gallery-gap)) / 3);
    }
    .travel-photo { aspect-ratio: auto; }
    .travel-gallery__heading { align-items: start; }
    .travel-gallery__introduction { max-width: 15rem; padding-top: 2rem; }
  }

  @media (max-width: 599px) {
    .travel-gallery__heading { display: block; }
    .travel-gallery__introduction { max-width: none; margin-top: 1.5rem; }
    .travel-gallery__introduction > p { max-width: 17rem; }
    .travel-gallery__introduction > span { margin-top: 0.85rem; }
    .travel-gallery__grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: none; gap: 1rem; }
    .travel-photo { grid-area: auto; aspect-ratio: 3 / 2; }
    .travel-photo--portrait { aspect-ratio: 3 / 4; }
    .travel-photo__city { font-size: 2rem; }
    figcaption { bottom: 1rem; left: 1.1rem; }
    .travel-gallery__colophon { flex-direction: column; gap: 0.35rem; }
    .travel-viewer { width: 96vw; max-width: 96vw; padding: 0.8rem; }
    .travel-viewer__top > span { max-width: 9rem; font-size: 0.55rem; }
    .travel-viewer__navigation { gap: 0.55rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .travel-viewer[open] { animation: none; }
    .travel-photo img, .travel-photo__expand { transition: none; }
  }
</style>
