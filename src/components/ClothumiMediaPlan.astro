---
import { Image } from 'astro:assets';
import workflow from '../assets/media/tactile-umi/workflow.svg';
import algorithm from '../assets/media/tactile-umi/algorithm.svg';
import collectionGuiOriginal from '../assets/media/tactile-umi/collection-gui-original.png';
import gripperCalibration from '../assets/media/tactile-umi/gripper-calibration.png';
import tactileLatency from '../assets/media/tactile-umi/tactile-latency.png';
import questCameraLatency from '../assets/media/tactile-umi/quest-camera-latency-alignment.png';
import pacmanPreview from '../assets/media/clothumi-taichi/pacman.gif';
import pacmanStill from '../assets/media/clothumi-taichi/pacman-still.png';

const simulationDatasetUrl = 'https://huggingface.co/datasets/LancetRobotics/uniforce_loading_only_30f_rect_safe_500k_v2_gray_jpeg30k';

const stages = [
  {
    number: '01',
    title: 'Calibrate the geometry and clocks',
    body: 'Independent camera intrinsics, FR3 eye-in-hand calibration, UMI–Quest hand–eye calibration, a gripper-width lookup table, and measured stream offsets establish one explicit coordinate and timing contract.',
  },
  {
    number: '02',
    title: 'Record first, align second',
    body: 'Wrist RGB, two tactile cameras, Quest motion, and gripper state retain their native timestamps in raw H5. Alignment and camera-relative pose derivation are reproducible post-processing steps.',
  },
  {
    number: '03',
    title: 'Audit before policy training',
    body: 'CLI and web review expose missing streams, timing faults, and invalid episodes. Only accepted trajectories are promoted to the clean Zarr dataset consumed by training.',
  },
] as const;

const calibrationMetrics = [
  { value: '40', label: 'Quest–camera pose pairs', note: 'PARK hand–eye solution; no pair rejected' },
  { value: '1.67 / 3.09 / 1.91 mm', label: 'Fixed-board translation spread', note: 'Axis-wise consistency check, not external ground truth' },
  { value: '−56.738 / +25 ms', label: 'Measured stream offsets', note: 'Quest to RGB / right tactile to RGB' },
  { value: '8.7–63.0 mm', label: 'Calibrated gripper range', note: 'Five-point lookup table used at runtime' },
] as const;
---

<section class="tactile-architecture section-shell" aria-labelledby="tactile-architecture-title">
  <header class="tactile-heading">
    <p class="eyebrow">System architecture · Source-grounded workflow</p>
    <div>
      <h2 id="tactile-architecture-title">One system, four sensor streams, one robot-ready timeline.</h2>
      <p>
        Tactile UMI treats calibration and data quality as part of the learning system—not as hidden setup.
        Human demonstrations remain inspectable from acquisition through alignment, curation, representation
        learning, and Franka FR3 deployment.
      </p>
    </div>
  </header>

  <figure class="architecture-figure architecture-figure--workflow">
    <div class="architecture-figure__bar">
      <span>01 / End-to-end workflow</span>
      <a href={workflow.src} target="_blank" rel="noreferrer">Open full resolution ↗</a>
    </div>
    <a class="architecture-figure__image" href={workflow.src} target="_blank" rel="noreferrer" aria-label="Open the Tactile UMI workflow diagram at full resolution">
      <img src={workflow.src} alt="Tactile UMI workflow from calibration and multimodal demonstration capture through dataset curation, tactile representation learning, and Franka FR3 deployment" loading="lazy" />
    </a>
    <figcaption>Setup and calibration → collection and curation → representation and policy learning.</figcaption>
  </figure>

  <ol class="tactile-stages">
    {stages.map((stage) => (
      <li>
        <span>{stage.number}</span>
        <h3>{stage.title}</h3>
        <p>{stage.body}</p>
      </li>
    ))}
  </ol>

  <figure class="architecture-figure architecture-figure--algorithm">
    <div class="architecture-figure__bar">
      <span>02 / Learning architecture</span>
      <a href={algorithm.src} target="_blank" rel="noreferrer">Open full resolution ↗</a>
    </div>
    <a class="architecture-figure__image" href={algorithm.src} target="_blank" rel="noreferrer" aria-label="Open the Tactile UMI learning architecture at full resolution">
      <img src={algorithm.src} alt="Tactile UMI algorithm architecture showing temporal UniForce pretraining and real-sensor adaptation followed by frozen tactile conditioning for Diffusion Policy" loading="lazy" />
    </a>
    <figcaption>
      UniForce is pretrained on loading-only simulation, adapted with paired physical-sensor sequences, then
      frozen during policy training. Six-frame histories from both tactile sensors become contact tokens beside
      wrist RGB and robot state; the policy predicts an eight-step, camera-relative 7D action chunk.
    </figcaption>
  </figure>

  <section class="tactile-training" aria-labelledby="tactile-training-title">
    <header class="tactile-training__heading">
      <p class="eyebrow">UniForce · Two-stage tactile representation learning</p>
      <h3 id="tactile-training-title">Simulation first. Physical contact second.</h3>
      <p>
        UniForce is not trained directly on UMI demonstrations alone. A Taichi-generated loading-only dataset
        establishes the tactile representation; paired real-sensor presses then adapt it to the physical fingertips.
        The adapted encoder is frozen before Diffusion Policy training.
      </p>
    </header>

    <div class="tactile-training__stages">
      <article>
        <span>01 / Simulation pretraining</span>
        <h4>Learn from controlled indentation.</h4>
        <p>Taichi simulates marker-field deformation under varied indenter shapes and loading trajectories. The single loop below is an illustrative preview—not the complete training dataset.</p>
        <a class="text-link" href={simulationDatasetUrl} target="_blank" rel="noreferrer">Explore the public simulation dataset ↗</a>
      </article>
      <article>
        <span>02 / Real-sensor fine-tuning</span>
        <h4>Adapt to measured fingertip contact.</h4>
        <p>Physical indenter presses provide paired, frame-aligned images from the custom GelSight and GelSight Mini. The collection shown in the meeting slide covers six indenters with 1,000 frames each; this is distinct from the public simulation dataset and the UMI demonstration corpus.</p>
      </article>
    </div>

    <div class="tactile-training__previews" aria-label="Selected Taichi simulation preview">
      <figure>
        <picture>
          <source media="(prefers-reduced-motion: reduce)" srcset={pacmanStill.src} />
          <img src={pacmanPreview.src} alt="Pacman indenter: simulated tactile marker deformation and loading trajectory" width="760" height="341" loading="lazy" decoding="async" />
        </picture>
        <figcaption>Pacman · loading-only simulation</figcaption>
      </figure>
    </div>
    <p class="tactile-training__note">This GIF shows ten short example episodes for one indenter. The linked Hugging Face repository hosts the public JPEG-format simulation dataset, not the real-sensor recordings.</p>
  </section>

  <div class="tactile-operations" aria-labelledby="tactile-operations-title">
    <div class="tactile-operations__heading">
      <p class="eyebrow">Operational tooling</p>
      <h3 id="tactile-operations-title">The dataset has an interface, a ledger, and a gate.</h3>
      <p>Collection and audit tools make synchronized evidence visible before an episode enters the training corpus.</p>
    </div>
    <div class="tactile-operations__grid">
      <figure>
        <a href={collectionGuiOriginal.src} target="_blank" rel="noreferrer" aria-label="Open the original Tactile UMI collection interface screenshot at full resolution"><Image src={collectionGuiOriginal} alt="Uncropped Tactile UMI collection interface from the 11 June meeting, showing wrist RGB, two tactile views, Quest view, device status, recording controls, and terminal logs" widths={[960, 1440, 1920, 2470]} sizes="(max-width: 767px) 100vw, 90vw" format="avif" quality={84} loading="lazy" /></a>
        <figcaption><span>Collection</span> Full collection interface from the 11 June meeting, shown without cropping. Open the image to inspect the original recording controls and sensor views.</figcaption>
      </figure>
    </div>
  </div>

  <div class="tactile-calibration" aria-labelledby="tactile-calibration-title">
    <div class="tactile-calibration__intro">
      <p class="eyebrow">Calibration ledger</p>
      <h3 id="tactile-calibration-title">Every transformation is measured before it is trusted.</h3>
      <p>These checks establish reproducible operating values. They should be repeated whenever a camera or physical mounting changes.</p>
    </div>
    <dl class="tactile-calibration__metrics">
      {calibrationMetrics.map((metric) => (
        <div>
          <dt>{metric.label}</dt>
          <dd>{metric.value}</dd>
          <p>{metric.note}</p>
        </div>
      ))}
    </dl>
    <div class="tactile-calibration__method">
      <div>
        <p class="eyebrow">Quest ↔ main camera · Motion-based latency</p>
        <h4>Align the same motion in two clocks.</h4>
      </div>
      <div>
        <p>With the camera and Quest rigidly mounted on the UMI, the device moves in view of a stationary ArUco marker. The main camera estimates the marker’s position from video and calibrated intrinsics; the Quest records the corresponding controller trajectory, transformed into the camera frame by the measured hand–eye transform.</p>
        <p>Following the one-axis trajectory alignment in <a href="https://proceedings.mlr.press/v305/xu25e.html" target="_blank" rel="noreferrer">exUMI ↗</a>, the calibration compares normalized motion along a matching axis, selecting the Quest-axis sign for the opposite apparent marker motion. This implementation uses smoothed velocity by default and searches for the scalar time offset that minimizes the overlapping signals’ mean-squared error.</p>
        <p>The accepted run estimated <strong>−56.738 ms</strong> in the convention “sample Quest at camera time + offset”: the main camera trails Quest by about <strong>56.7 ms</strong>. To align the recorded streams, Quest timestamps are shifted 56.738 ms later. This is a measured setup value, not a universal hardware latency.</p>
      </div>
    </div>
    <div class="tactile-calibration__visuals">
      <figure>
        <div><Image src={tactileLatency} alt="Tactile UMI timing-calibration plot aligning tactile and RGB contact signals" widths={[720, 1080, 1600]} sizes="(max-width: 767px) 100vw, 48vw" format="avif" quality={84} loading="lazy" /></div>
        <figcaption>Cross-stream timing alignment</figcaption>
      </figure>
      <figure>
        <div><Image src={gripperCalibration} alt="Tactile UMI gripper-width calibration interface and fitted lookup points" widths={[640, 960, 1280]} sizes="(max-width: 767px) 100vw, 40vw" format="avif" quality={84} loading="lazy" /></div>
        <figcaption>Gripper-width lookup calibration</figcaption>
      </figure>
      <figure class="tactile-calibration__quest">
        <a href={questCameraLatency.src} target="_blank" rel="noreferrer" aria-label="Open the Quest and main-camera latency alignment plot at full resolution"><Image src={questCameraLatency} alt="Quest and main-camera one-axis motion curves aligned by shifting Quest 0.0567 seconds later" widths={[720, 1080, 1440]} sizes="(max-width: 767px) 100vw, 90vw" format="avif" quality={84} loading="lazy" /></a>
        <figcaption>Quest–main-camera alignment · Accepted calibration run, also shown in the 11 June meeting slide 6</figcaption>
      </figure>
    </div>
  </div>

  <aside class="tactile-acknowledgement" aria-label="UniForce research acknowledgement">
    <span>Research acknowledgement</span>
    <div>
      <p>
        The UniForce-based tactile representation work in Tactile UMI was developed under the guidance of
        <strong>Zhuo Chen</strong>. UniForce is an external tactile representation method and provides the frozen,
        force-aware branch used here.
      </p>
      <a class="text-link" href="https://arxiv.org/abs/2602.01153">UniForce · arXiv:2602.01153 <span aria-hidden="true">↗</span></a>
    </div>
  </aside>
</section>

<style>
  .tactile-architecture { padding-block: var(--space-9) var(--space-10); }
  .tactile-heading { display: grid; grid-template-columns: 4fr 8fr; gap: var(--page-gutter); padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .tactile-heading > div { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(15rem, .55fr); gap: clamp(2rem, 5vw, 6rem); align-items: end; }
  .tactile-heading h2 { max-width: 12em; font-family: var(--font-serif); font-size: clamp(2.8rem, 5.2vw, 6.1rem); font-weight: 430; letter-spacing: -.05em; line-height: .95; }
  .tactile-heading > div > p { color: var(--muted); font-size: .9rem; line-height: 1.72; }
  .architecture-figure { margin-top: clamp(4rem, 8vw, 8rem); border: 1px solid var(--line); background: #e8e7df; overflow: hidden; }
  .architecture-figure__bar { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 1rem; border-bottom: 1px solid var(--line); color: var(--muted); font-size: .64rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .architecture-figure__bar a { transition: color 180ms ease; }
  .architecture-figure__bar a:hover { color: var(--accent); }
  .architecture-figure__image { display: block; padding: clamp(.75rem, 2.2vw, 2rem); overflow: hidden; }
  .architecture-figure__image img { display: block; width: 100%; transition: transform 700ms cubic-bezier(.2,.7,.2,1); }
  .architecture-figure__image:hover img { transform: scale(1.012); }
  .architecture-figure figcaption { padding: 1rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .72rem; line-height: 1.65; }
  .architecture-figure--algorithm { margin-top: clamp(5rem, 9vw, 9rem); background: #efeee8; }
  .architecture-figure--algorithm figcaption { max-width: none; color: var(--ink-soft); }
  .tactile-training { margin-top: clamp(5rem, 9vw, 9rem); padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .tactile-training__heading { display: grid; grid-template-columns: 4fr 8fr; column-gap: var(--page-gutter); }
  .tactile-training__heading .eyebrow { grid-row: 1 / 3; }
  .tactile-training__heading h3 { max-width: 13em; font-family: var(--font-serif); font-size: clamp(2.3rem, 4.3vw, 4.8rem); font-weight: 440; letter-spacing: -.045em; line-height: 1; }
  .tactile-training__heading > p:last-child { max-width: 47rem; margin-top: 1.5rem; color: var(--muted); font-size: .85rem; line-height: 1.72; }
  .tactile-training__stages { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin-top: 3rem; border: 1px solid var(--line); background: var(--line); }
  .tactile-training__stages article { padding: clamp(1.5rem, 3vw, 3rem); background: var(--paper-deep); }
  .tactile-training__stages article > span { color: var(--accent); font-size: .7rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .tactile-training__stages h4 { max-width: 18em; margin-top: 2.5rem; font-family: var(--font-serif); font-size: clamp(1.7rem, 2.6vw, 2.8rem); font-weight: 450; letter-spacing: -.035em; line-height: 1.07; }
  .tactile-training__stages p { max-width: 35rem; margin-top: 1rem; color: var(--muted); font-size: .78rem; line-height: 1.7; }
  .tactile-training__stages .text-link { display: inline-block; margin-top: 1.7rem; font-size: .8rem; }
  .tactile-training__previews { max-width: 760px; margin: 1rem 0 0 auto; }
  .tactile-training__previews figure { min-width: 0; border: 1px solid var(--line); background: var(--night); }
  .tactile-training__previews picture, .tactile-training__previews img { display: block; width: 100%; }
  .tactile-training__previews img { height: auto; aspect-ratio: 760 / 341; object-fit: contain; }
  .tactile-training__previews figcaption { padding: .8rem 1rem; color: var(--paper); font-size: .7rem; }
  .tactile-training__note { max-width: 760px; margin: 1rem 0 0 auto; color: var(--muted); font-size: .72rem; line-height: 1.65; }
  .tactile-stages { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin-top: 1px; border: 1px solid var(--line); background: var(--line); list-style: none; }
  .tactile-stages li { min-height: 15rem; padding: clamp(1.4rem, 2.7vw, 2.6rem); background: var(--paper); }
  .tactile-stages li > span { color: var(--accent); font-size: .66rem; font-weight: 750; letter-spacing: .08em; }
  .tactile-stages h3 { max-width: 15em; margin-top: 3.5rem; font-family: var(--font-serif); font-size: clamp(1.55rem, 2.3vw, 2.5rem); font-weight: 450; letter-spacing: -.03em; line-height: 1.06; }
  .tactile-stages p { max-width: 34rem; margin-top: 1.15rem; color: var(--muted); font-size: .76rem; line-height: 1.7; }
  .tactile-operations { margin-top: clamp(6rem, 10vw, 10rem); }
  .tactile-operations__heading { display: grid; grid-template-columns: 3fr 5fr 4fr; gap: var(--page-gutter); align-items: end; padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .tactile-operations__heading h3, .tactile-calibration__intro h3 { font-family: var(--font-serif); font-size: clamp(2.2rem, 4vw, 4.5rem); font-weight: 440; letter-spacing: -.04em; line-height: 1; }
  .tactile-operations__heading > p:last-child, .tactile-calibration__intro > p:last-child { color: var(--muted); font-size: .82rem; line-height: 1.7; }
  .tactile-operations__grid { margin-top: 3rem; }
  .tactile-operations__grid figure { border: 1px solid var(--line); background: var(--paper-deep); }
  .tactile-operations__grid a { display: block; padding: clamp(.5rem, 1.4vw, 1.25rem); background: #171717; }
  .tactile-operations__grid :global(img) { display: block; width: 100%; height: auto; }
  .tactile-operations__grid figcaption { min-height: 5rem; padding: 1rem; color: var(--muted); font-size: .7rem; line-height: 1.6; }
  .tactile-operations__grid figcaption span { display: block; margin-bottom: .35rem; color: var(--ink); font-size: .62rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .tactile-calibration { display: grid; grid-template-columns: 4fr 8fr; gap: var(--page-gutter); margin-top: clamp(6rem, 10vw, 10rem); padding: clamp(2rem, 4vw, 4rem); background: var(--night); color: var(--paper); }
  .tactile-calibration__intro > .eyebrow { color: #a7b89f; }
  .tactile-calibration__intro h3 { margin-top: 2rem; }
  .tactile-calibration__intro > p:last-child { margin-top: 2rem; color: color-mix(in srgb, var(--paper) 62%, transparent); }
  .tactile-calibration__metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid rgba(255,255,255,.17); border-left: 1px solid rgba(255,255,255,.17); }
  .tactile-calibration__metrics > div { min-height: 12rem; padding: clamp(1rem, 2vw, 2rem); border-right: 1px solid rgba(255,255,255,.17); border-bottom: 1px solid rgba(255,255,255,.17); }
  .tactile-calibration__metrics dt { color: rgba(255,255,255,.48); font-size: .62rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }
  .tactile-calibration__metrics dd { margin-top: 2rem; font-family: var(--font-serif); font-size: clamp(1.75rem, 3vw, 3.4rem); letter-spacing: -.04em; line-height: 1; }
  .tactile-calibration__metrics p { margin-top: .75rem; color: rgba(255,255,255,.48); font-size: .65rem; line-height: 1.55; }
  .tactile-calibration__method { grid-column: 1 / -1; display: grid; grid-template-columns: 4fr 8fr; gap: var(--page-gutter); padding-block: clamp(2rem, 4vw, 4rem); border-top: 1px solid rgba(255,255,255,.17); }
  .tactile-calibration__method .eyebrow { color: #a7b89f; }
  .tactile-calibration__method h4 { max-width: 13em; margin-top: 1.5rem; font-family: var(--font-serif); font-size: clamp(1.8rem, 3.2vw, 3.4rem); font-weight: 440; line-height: 1.05; letter-spacing: -.035em; }
  .tactile-calibration__method > div:last-child { max-width: 48rem; }
  .tactile-calibration__method > div:last-child p { color: rgba(255,255,255,.75); font-size: clamp(.82rem, 1.05vw, 1rem); line-height: 1.75; }
  .tactile-calibration__method > div:last-child p + p { margin-top: 1.2rem; }
  .tactile-calibration__method strong { color: var(--paper); }
  .tactile-calibration__method a { color: var(--paper); text-decoration: underline; text-underline-offset: .2em; }
  .tactile-calibration__visuals { grid-column: 1 / -1; display: grid; grid-template-columns: 1.15fr .85fr; gap: 1px; margin-top: 1rem; background: rgba(255,255,255,.17); }
  .tactile-calibration__visuals figure { background: #f0f0ec; color: var(--ink); overflow: hidden; }
  .tactile-calibration__visuals figure > div { display: grid; aspect-ratio: 4 / 3; place-items: center; overflow: hidden; }
  .tactile-calibration__visuals :global(img) { display: block; width: 100%; height: 100%; object-fit: contain; }
  .tactile-calibration__visuals figcaption { padding: .8rem 1rem; border-top: 1px solid rgba(0,0,0,.14); color: var(--muted); font-size: .65rem; }
  .tactile-calibration__quest { grid-column: 1 / -1; }
  .tactile-calibration__quest a { display: block; padding: clamp(.5rem, 1.5vw, 1.25rem); }
  .tactile-calibration__quest :global(img) { width: 100%; height: auto; }
  .tactile-acknowledgement { display: grid; grid-template-columns: 4fr 8fr; gap: var(--page-gutter); margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .tactile-acknowledgement > span { color: var(--accent); font-size: .62rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .tactile-acknowledgement > div { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(12rem, .5fr); gap: 2rem; align-items: start; }
  .tactile-acknowledgement p { max-width: 48rem; color: var(--ink-soft); font-size: .8rem; line-height: 1.7; }
  .tactile-acknowledgement strong { color: var(--ink); }
  @media (max-width: 1023px) {
    .tactile-heading, .tactile-training__heading, .tactile-calibration, .tactile-calibration__method, .tactile-acknowledgement { grid-template-columns: 1fr; gap: 2.5rem; }
    .tactile-training__heading .eyebrow { grid-row: auto; }
    .tactile-heading > div { grid-template-columns: 1fr; gap: 2rem; }
    .tactile-operations__heading { grid-template-columns: 1fr 1.4fr; }
    .tactile-operations__heading > p:last-child { grid-column: 2; }
  }
  @media (max-width: 767px) {
    .architecture-figure__bar { align-items: flex-start; flex-direction: column; }
    .tactile-stages, .tactile-training__stages, .tactile-calibration__metrics, .tactile-calibration__visuals { grid-template-columns: 1fr; }
    .tactile-stages li { min-height: auto; }
    .tactile-stages h3 { margin-top: 2.5rem; }
    .tactile-operations__heading { grid-template-columns: 1fr; gap: 1.5rem; }
    .tactile-operations__heading > p:last-child { grid-column: 1; }
    .tactile-calibration { margin-inline: calc(var(--page-gutter) * -1); padding-inline: var(--page-gutter); }
    .tactile-calibration__metrics > div { min-height: 10rem; }
    .tactile-acknowledgement > div { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .architecture-figure__image img { transition: none; } }
</style>
