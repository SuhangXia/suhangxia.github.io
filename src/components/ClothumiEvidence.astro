---
const corpus = [
  { value: '222', label: 'complete demonstrations' },
  { value: '135,952', label: 'policy frames in the full corpus' },
  { value: '77', label: 'demonstrations in the strict subset' },
  { value: '68', label: 'physical evaluation rollouts' },
] as const;
---

<section class="trial-summary" id="controlled-evaluation" aria-labelledby="clothumi-evidence-title">
  <header class="trial-summary__heading">
    <div>
      <p class="eyebrow">Controlled evaluation · 68 physical rollouts</p>
      <h4 id="clothumi-evidence-title">Does tactile conditioning help?</h4>
    </div>
    <p>Shared RGB, state, actions and protocol; only tactile conditioning differs.</p>
  </header>

  <table class="trial-summary__table">
    <caption class="sr-only">Contact success across 68 physical rollouts, with Wilson 95% confidence intervals.</caption>
    <thead>
      <tr>
        <th scope="col">Policy</th>
        <th scope="col">Contacts</th>
        <th scope="col"><span>Success rate</span><small>Wilson 95% CI</small></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">Vision-only DP</th>
        <td>10 / 34</td>
        <td><strong>29.4%</strong><small>16.8–46.2%</small></td>
      </tr>
      <tr class="trial-summary__tactile">
        <th scope="row">UniForce + DP</th>
        <td>14 / 34</td>
        <td><strong>41.2%</strong><small>26.4–57.8%</small></td>
      </tr>
    </tbody>
  </table>

  <p class="trial-summary__difference"><span>Observed difference</span><strong>+4</strong><span>successful contacts</span><span aria-hidden="true">·</span><span>+11.8 percentage points</span></p>

  <div class="trial-summary__protocol">
    <p><strong>Shared training basis</strong><span>Same 77-demonstration subset: 65 training / 12 validation episodes.</span></p>
    <p><strong>Task &amp; success criterion</strong><span>White cylinder → white plate. Success means contact, not stable placement.</span></p>
  </div>

  <p class="trial-summary__boundary">Preliminary comparison; two-sided Fisher exact test, p = 0.447 (not statistically significant).</p>

  <details class="trial-summary__details">
    <summary>Model conditions, dataset context &amp; limitations</summary>
    <div class="trial-summary__details-content">
      <p class="trial-summary__context">Two Diffusion Policy conditions share wrist RGB, robot state, camera-relative actions and rollout protocol; only the tactile pathway differs.</p>
      <p class="trial-summary__context">A fixed-layout, low-contrast white cylinder is moved toward a white plate.</p>
      <dl class="trial-summary__corpus" aria-label="Tactile UMI dataset and evaluation scale">
        {corpus.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
      </dl>
      <dl class="trial-summary__conditions" aria-label="Tactile UMI policy comparison">
        <div><dt>Shared condition</dt><dd><strong>Wrist RGB + state</strong><span>Frozen DINO ViT-B base with LoRA in the last four blocks · two observation steps</span></dd></div>
        <div><dt>Added condition</dt><dd><strong>Dual tactile history</strong><span>2 sides × 6 causal frames → frozen UniForce → 8 contact tokens</span></dd></div>
        <div><dt>Shared output</dt><dd><strong>Diffusion Policy</strong><span>Eight camera-relative 7D actions: translation, rotation, and gripper width</span></dd></div>
      </dl>
      <p>This preliminary evaluation does not establish broad generalisation, cloth-manipulation performance, stable placement, or a causal mechanism for the improvement.</p>
      <p>The π0.5 integration is separate and is not included in this comparison.</p>
    </div>
  </details>
</section>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .trial-summary { margin-top: clamp(1.75rem, 3vw, 3rem); padding-top: 1.25rem; border-top: 1px solid var(--line); scroll-margin-top: 7rem; }
  .trial-summary__heading { display: grid; grid-template-columns: 1fr 1fr; align-items: end; gap: 1rem 3rem; }
  .trial-summary__heading .eyebrow { font-size: .7rem; }
  .trial-summary__heading h4 { margin: .6rem 0 0; font: 450 clamp(1.6rem, 2.5vw, 2.5rem)/1.1 var(--font-serif); letter-spacing: -.03em; }
  .trial-summary__heading > p { max-width: 42rem; font-size: .9rem; line-height: 1.7; color: var(--muted); }
  .trial-summary__table { width: 100%; margin-top: 1.5rem; border-collapse: collapse; text-align: left; font-size: .95rem; font-variant-numeric: tabular-nums; }
  .trial-summary__table th, .trial-summary__table td { padding: .85rem 1rem; border-bottom: 1px solid var(--line); vertical-align: middle; }
  .trial-summary__table thead th { color: var(--muted); font-size: .8rem; font-weight: 600; }
  .trial-summary__table thead th:first-child { width: 42%; }
  .trial-summary__table thead th:nth-child(2) { width: 25%; }
  .trial-summary__table tbody th { font-weight: 600; }
  .trial-summary__table td:nth-child(2) { white-space: nowrap; }
  .trial-summary__table td strong { font-size: 1.15rem; font-weight: 650; }
  .trial-summary__table small { display: block; margin-top: .15rem; font-size: .78rem; line-height: 1.5; color: var(--muted); font-weight: 400; }
  .trial-summary__tactile { background: var(--paper-deep); }
  .trial-summary__tactile th { box-shadow: inset 2px 0 var(--accent); }
  .trial-summary__difference { display: flex; flex-wrap: wrap; align-items: baseline; gap: .3rem .65rem; margin-top: .8rem; font-size: .85rem; color: var(--muted); }
  .trial-summary__difference strong { font-weight: 650; color: var(--ink); }
  .trial-summary__protocol { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 3rem; margin-top: 1.5rem; }
  .trial-summary__protocol p { font-size: .87rem; line-height: 1.75; color: var(--muted); }
  .trial-summary__protocol strong { display: block; margin-bottom: .25rem; font-size: .83rem; font-weight: 650; color: var(--ink); }
  .trial-summary__boundary { margin-top: 1rem; font-size: .83rem; line-height: 1.75; color: var(--muted); }
  .trial-summary__details { margin-top: 1rem; border-top: 1px solid var(--line); }
  .trial-summary__details summary { width: fit-content; max-width: 100%; padding: .85rem 0; color: var(--ink-soft); cursor: pointer; font-size: .83rem; line-height: 1.6; }
  .trial-summary__details-content { padding-bottom: 1rem; font-size: .85rem; line-height: 1.75; color: var(--muted); }
  .trial-summary__context { margin-bottom: .75rem; }
  .trial-summary__corpus { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .8rem; margin-bottom: 1.25rem; }
  .trial-summary__corpus dt { font-size: .78rem; }
  .trial-summary__corpus dd { margin: .2rem 0 0; color: var(--ink); font-size: 1rem; font-weight: 650; }
  .trial-summary__conditions { display: grid; gap: .7rem; margin-bottom: 1rem; }
  .trial-summary__conditions > div { display: grid; grid-template-columns: 8rem 1fr; gap: 1rem; }
  .trial-summary__conditions dt { font-size: .78rem; }
  .trial-summary__conditions dd { margin: 0; }
  .trial-summary__conditions strong, .trial-summary__conditions span { display: block; }
  .trial-summary__conditions strong { color: var(--ink); font-weight: 600; }
  @media (max-width: 767px) {
    .trial-summary__heading, .trial-summary__protocol { grid-template-columns: 1fr; gap: .9rem; }
    .trial-summary__table { font-size: .85rem; }
    .trial-summary__table th, .trial-summary__table td { padding: .75rem .5rem; }
    .trial-summary__table thead th:first-child { width: 38%; }
    .trial-summary__table thead th:nth-child(2) { width: 25%; }
    .trial-summary__table thead th { font-size: .72rem; }
    .trial-summary__table td strong { font-size: 1rem; }
    .trial-summary__table small { font-size: .72rem; }
    .trial-summary__corpus { grid-template-columns: 1fr 1fr; }
    .trial-summary__conditions > div { grid-template-columns: 1fr; gap: .15rem; }
  }
</style>
