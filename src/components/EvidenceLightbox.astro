<dialog id="evidence-lightbox" class="evidence-lightbox" aria-labelledby="evidence-lightbox-title">
  <div class="evidence-lightbox__bar">
    <h2 id="evidence-lightbox-title"></h2>
    <form method="dialog"><button aria-label="Close image" autofocus>Close ×</button></form>
  </div>
  <div class="evidence-lightbox__stage"><img alt="" /></div>
  <a class="evidence-lightbox__original" target="_blank" rel="noopener">Open original at full resolution ↗</a>
</dialog>

<script>
  import { currentLocale } from '../scripts/language';
  import { translate } from '../data/i18n';

  const lightbox = document.querySelector<HTMLDialogElement>('#evidence-lightbox');
  if (lightbox) {
    const picture = lightbox.querySelector<HTMLImageElement>('img')!;
    const title = lightbox.querySelector<HTMLElement>('h2')!;
    const original = lightbox.querySelector<HTMLAnchorElement>('.evidence-lightbox__original')!;
    let trigger: HTMLAnchorElement | null = null;
    let previousOverflow = '';
    document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox-src]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || !lightbox.showModal) return;
        event.preventDefault();
        trigger = link;
        picture.src = link.dataset.lightboxSrc!;
        picture.alt = link.querySelector('img')?.alt ?? link.dataset.lightboxTitle ?? '';
        title.textContent = translate(link.dataset.lightboxTitle ?? 'Evidence image', currentLocale());
        original.href = picture.src;
        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        lightbox.showModal();
      });
    });
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) lightbox.close();
    });
    lightbox.addEventListener('close', () => {
      document.body.style.overflow = previousOverflow;
      picture.removeAttribute('src');
      trigger?.focus({ preventScroll: true });
    });
    document.addEventListener('suhangxia:localechange', () => {
      if (lightbox.open && trigger) {
        title.textContent = translate(trigger.dataset.lightboxTitle ?? 'Evidence image', currentLocale());
      }
    });
  }
</script>

<style>
  .evidence-lightbox { width: min(96vw, 100rem); max-width: 96vw; max-height: 94dvh; margin: auto; padding: clamp(.8rem, 2vw, 1.75rem); border: 1px solid var(--line); background: var(--paper-raised); color: var(--ink); overscroll-behavior: contain; }
  .evidence-lightbox::backdrop { background: rgba(10, 14, 12, .86); }
  .evidence-lightbox__bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  h2 { font-size: clamp(1rem, 2vw, 1.5rem); line-height: 1.3; }
  button { padding: .75rem 1rem; border: 1px solid var(--line); white-space: nowrap; cursor: pointer; font: inherit; }
  .evidence-lightbox__stage { display: flex; justify-content: center; }
  img { display: block; max-width: 100%; max-height: 72dvh; width: auto; height: auto; object-fit: contain; }
  .evidence-lightbox__original { display: inline-block; margin-top: 1rem; padding-block: .5rem; font-size: .85rem; text-decoration: underline; text-underline-offset: .25em; }
</style>
