<section class="audit-replay section-shell" aria-labelledby="audit-replay-title">
  <header class="audit-replay__heading">
    <p class="eyebrow">Dataset Audit · One recorded trajectory</p>
    <div>
      <h3 id="audit-replay-title">Inspect a demonstration across space, time, and touch.</h3>
      <p>
        A read-only export of episode 000001 from the Tactile UMI audit viewer. Scrub one 18-second recording
        alongside its camera trajectory, wrist RGB, two tactile streams, and gripper-width trace. No local dataset
        path or audit controls are exposed on this public page.
      </p>
    </div>
  </header>

  <div class="audit-replay__frame" data-audit-replay>
    <div class="audit-replay__poster" data-audit-poster>
      <img src="/media/tactile-umi/audit-episode-000001-preview.png" alt="Read-only Rerun audit preview showing a 3D trajectory, wrist camera, dual tactile views, camera-position plots, and gripper-width trace" width="1400" height="900" loading="lazy" />
      <div class="audit-replay__poster-shade"></div>
      <div class="audit-replay__poster-label">
        <span>Episode 000001 · Read-only replay</span>
        <button type="button" data-audit-open aria-controls="audit-replay-viewer" aria-expanded="false">Explore trajectory <span aria-hidden="true">↗</span></button>
      </div>
    </div>
    <iframe id="audit-replay-viewer" title="Interactive Tactile UMI audit replay of one trajectory" allow="fullscreen" loading="lazy" hidden data-audit-frame></iframe>
  </div>

  <div class="audit-replay__foot">
    <p>
      The archived audit ran relative-action checks with IK checks disabled. This replay demonstrates synchronized
      records, not robot IK feasibility or task success.
    </p>
    <a href="/media/tactile-umi/viewer.html" target="_blank" rel="noreferrer">Open replay full screen ↗</a>
  </div>
</section>

<script>
  const openButton = document.querySelector<HTMLButtonElement>('[data-audit-open]');
  openButton?.addEventListener('click', () => {
    const root = openButton.closest<HTMLElement>('[data-audit-replay]');
    const frame = root?.querySelector<HTMLIFrameElement>('[data-audit-frame]');
    const poster = root?.querySelector<HTMLElement>('[data-audit-poster]');
    if (!frame || !poster) return;
    frame.src = '/media/tactile-umi/viewer.html';
    frame.hidden = false;
    poster.hidden = true;
    openButton.setAttribute('aria-expanded', 'true');
  }, { once: true });
</script>

<style>
