---
import { site } from '../data/site';
import { alternatePath, localePath, translate, type Locale } from '../data/i18n';

interface Props {
  currentPath?: string;
  locale?: Locale;
}

const { currentPath = '/', locale = 'en' } = Astro.props;
const isCurrent = (href: string) => {
  const path = localePath(href, locale);
  return currentPath === path || currentPath.startsWith(`${path}/`);
};
---

<header class="site-header" data-site-header>
  <a class="site-mark" href={localePath('/', locale)} aria-label={translate('Suhang Xia, home', locale)}>
    <span>Suhang Xia</span>
  </a>

  <button
    class="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="site-navigation"
    aria-label={translate('Open navigation', locale)}
    data-menu-toggle
  >
    <span></span>
    <span></span>
  </button>

  <nav class="site-nav" id="site-navigation" aria-label={translate('Primary navigation', locale)} data-site-nav>
    <div class="site-nav__inner">
      {site.navigation.map((item) => (
        <>
          <a
            href={localePath(item.href, locale)}
            class:list={{ active: isCurrent(item.href) }}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            <span>{translate(item.label, locale)}</span>
          </a>
          {item.href === '/research' && (
            <>
              <a class="site-nav__language" href={alternatePath(Astro.url.pathname, locale)} hreflang={locale === 'en' ? 'zh-CN' : 'en'} aria-label={locale === 'en' ? '切换为中文' : 'Switch to English'}>{locale === 'en' ? '中文' : 'EN'}</a>
              <a
                class="site-nav__github"
                href="https://github.com/suhangxia"
                target="_blank"
                rel="noreferrer"
                aria-label={translate('Suhang Xia on GitHub', locale)}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M12 .3a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.24c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.31.76-1.61-2.67-.31-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23A11.5 11.5 0 0 1 12 6.09c1.02 0 2.04.14 3 .4 2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.62-5.48 5.92.43.38.81 1.12.81 2.25v3.28c0 .32.22.69.82.58A12 12 0 0 0 12 .3Z"
                  />
                </svg>
                <span class="site-nav__github-label">GitHub</span>
              </a>
            </>
          )}
        </>
      ))}
    </div>
  </nav>
</header>
